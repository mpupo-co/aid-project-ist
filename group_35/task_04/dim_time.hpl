    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <calculation>
      <calc_type>SUBTRACT</calc_type>
      <conversion_mask/>
      <currency_symbol/>
      <decimal_symbol/>
      <field_a>max_year</field_a>
      <field_b>min_year</field_b>
      <field_c/>
      <field_name>n_years</field_name>
      <grouping_symbol/>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Number</value_type>
    </calculation>
    <failIfNoFile>Y</failIfNoFile>
