  <transform>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DevelopmentDB</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT MIN(year) AS min_year,
       MAX(year) AS max_year
FROM (
    SELECT year FROM maddison_indicators
    UNION ALL
    SELECT year FROM wdi_indicators
    UNION ALL
    SELECT year FROM historical_events
) AS all_years</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>32</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
