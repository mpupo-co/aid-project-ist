    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>DevelopmentDW</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>event_id</field>
        <name>event_id</name>
        <name2/>
      </key>
      <schema>DevelopmentDW</schema>
      <table>BRIDGE_EVENT</table>
      <value>
        <name>event_id</name>
        <rename>event_id</rename>
