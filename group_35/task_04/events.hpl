  <transform>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DevelopmentDB</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>  SELECT country_iso3, year, event, category, economic_impact, event_id
  FROM historical_events</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>48</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Insert / update</name>
    <type>InsertUpdate</type>
    <description/>
