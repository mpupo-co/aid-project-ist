  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Database lookup COUNTRY</from>
      <to>Database lookup TIME</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Table input</from>
      <to>Database lookup COUNTRY</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Database lookup TIME</from>
      <to>Insert / update</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Database lookup COUNTRY</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <connection>DevelopmentDW</connection>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <field>iso3_code</field>
        <name>country_iso3</name>
      </key>
      <schema>DevelopmentDW</schema>
      <table>DIM_COUNTRY</table>
      <value>
        <name>country_key</name>
        <trim_type>none</trim_type>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>192</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Database lookup TIME</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <connection>DevelopmentDW</connection>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <field>year</field>
        <name>year</name>
      </key>
      <schema>DevelopmentDW</schema>
      <table>DIM_TIME</table>
      <value>
        <name>time_key</name>
        <trim_type>none</trim_type>
