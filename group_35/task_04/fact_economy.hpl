    <limit>0</limit>
    <sql>  SELECT country_iso3, year, indicator_code, value
  FROM maddison_indicators
  WHERE indicator_code IN ('gdppc', 'gdp')
  UNION ALL
  SELECT country_iso3, year, indicator_code, value
  FROM wdi_indicators
  WHERE indicator_code IN ('NY.GDP.MKTP.KD.ZG', 'NE.EXP.GNFS.ZS', 'NE.IMP.GNFS.ZS')</sql>
